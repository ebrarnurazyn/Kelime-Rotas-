# Kelime Rotası — ortam değişkenleri örneği
# Bu dosyayı ".env" adıyla kopyalayın ve gerçek değerleri girin.
# .env dosyasını asla paylaşmayın veya bir git deposuna eklemeyin.

NVIDIA_API_KEY=nvapi-buraya-kendi-anahtarinizi-yapistirin

# İsteğe bağlı: build.nvidia.com kataloğundan farklı bir model kullanmak isterseniz
# (varsayılan: meta/llama-3.1-8b-instruct)
#NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# ------------------------------------------------------------------
# Veritabanı
# Yerel geliştirme: `docker compose up -d` çalıştırın, aşağıdaki değerler docker-compose.yml'deki
# Postgres'e işaret ediyor, değiştirmenize gerek yok.
# Production (Vercel): Neon projenizdeki "Connection string" sayfasından alınan pooled
# (DATABASE_URL) / unpooled (DIRECT_URL) değerlerini Vercel proje ayarlarına girin — bu .env
# dosyasını değil.
# ------------------------------------------------------------------
DATABASE_URL=postgresql://kelime:kelime@localhost:5432/kelime_rotasi?schema=public
DIRECT_URL=postgresql://kelime:kelime@localhost:5432/kelime_rotasi?schema=public

# NextAuth (Auth.js) — öğretmen oturumlarını imzalamak için kullanılıyor
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=buraya-rastgele-uretilmis-bir-anahtar-gelecek
NEXTAUTH_URL=http://localhost:3000

# Öğrenci oturum cookie'sini imzalamak için ayrı bir gizli anahtar (jose)
STUDENT_SESSION_SECRET=buraya-rastgele-uretilmis-bir-anahtar-gelecek
